+	written           int
+	write_interest    bool
+	read_interest     bool = true
+	dirty             bool
+	read_scheduled    bool
+	closing           bool
+	close_received    bool
+	abort_after_flush bool
+	close_code        int = 1000
+	close_reason      string
+	read_timeout      time.Duration
+	last_read         u64
+	write_progress    u64
+	close_started     u64
+}
