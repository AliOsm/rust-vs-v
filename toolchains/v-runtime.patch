+		unsafe { C.memcpy(&word, &u8(payload.data) + offset, 8) }
+		word ^= key
+		unsafe { C.memcpy(&u8(payload.data) + offset, &word, 8) }
+		offset += 8
+	}
+	for offset < payload.len {
+		payload[offset] ^= mask[offset % 4]
+		offset++
+	}
+}
